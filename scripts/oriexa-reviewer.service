[Unit]
Description=Oriexa Reviewer Agent
After=network.target oriexa-api.service
Wants=oriexa-api.service

[Service]
User=root
WorkingDirectory=/opt/oriexa/repo
EnvironmentFile=/opt/oriexa/repo/.env
Environment=PYTHONUNBUFFERED=1
Environment=ORIEXA_BASE_URL=http://127.0.0.1:8000
Environment=ORIEXA_REVIEWER_API_KEY=${REVIEWER_AGENT_API_KEY}
ExecStart=/opt/oriexa/repo/.venv/bin/python -u reviewer-agent/run.py \
    --daemon \
    --interval 30
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
